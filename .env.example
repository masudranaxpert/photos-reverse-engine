# ==============================================================================
# Instant Engine - Environment Configuration
# ==============================================================================

# Secret key for admin JWT authentication
SECRET_KEY=photos-engine-super-secret-jwt-key-2026-production

# Logging Configuration
# Set to 'false' for clean logs, 'true' to include function name and line number
LOG_SHOW_CALLER=false
LOG_LEVEL=INFO
LOG_ROTATION=10 MB
LOG_RETENTION_APP=14 days
LOG_RETENTION_ERROR=30 days

# Cloudflare Worker Proxy for DASH Manifests (masks server IP from video playback URLs)
MANIFEST_PROXY_URL=https://curly-mountain-4fe1.ood-sakib-2.workers.dev
